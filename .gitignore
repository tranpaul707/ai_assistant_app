# --- Secrets / local env (keep *.example tracked) ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
client_secret*.json
credentials.json
token.json
tokens.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.dmypy.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# --- Runtime data (local only; keep folder via .gitkeep) ---
back-end/data/**
!back-end/data/.gitkeep

# Legacy paths if they reappear
back-end/src/chroma_db/
back-end/src/uploads/

# --- Frontend ---
front-end/node_modules/
front-end/dist/
front-end/dist-ssr/
front-end/*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
