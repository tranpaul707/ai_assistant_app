# Google OAuth (Web application client) — used by the backend for Gmail API.
# Create at: Google Cloud Console → APIs & Services → Credentials
# Enable Gmail API. Authorized redirect URI must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback

# Where the browser should return after Gmail OAuth (Vite origin).
FRONTEND_ORIGIN=http://localhost:5173

# Required for encrypted Gmail credentials. Generate a dedicated Fernet key:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Store the generated value only in your local .env / deployment secret manager.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional overrides
# REDIS_URI=redis://localhost:6379
# Calendar windows for Gmail searches; UTC unless a timezone is configured.
GMAIL_TIMEZONE=UTC
